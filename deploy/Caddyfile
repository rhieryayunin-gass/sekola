{
  email {$ACME_EMAIL}
  admin off
}

{$WEB_DOMAIN} {
  header {
    -Server
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  reverse_proxy web:3000
}

{$API_DOMAIN} {
  header {
    -Server
    Strict-Transport-Security "max-age=31536000"
  }
  reverse_proxy api:3001
}
