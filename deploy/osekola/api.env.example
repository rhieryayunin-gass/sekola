# Install as /etc/osekola/api.env, root-owned mode 0600.
# release.env in each immutable API release provides RELEASE_SHA.
NODE_ENV=production
HOST=127.0.0.1
PORT=3020
CORS_ORIGINS=https://osekola.com,https://www.osekola.com
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NODE_OPTIONS=--max-old-space-size=512
